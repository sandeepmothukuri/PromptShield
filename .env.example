# PromptShield-Lab — environment configuration
# Copy to `.env` and adjust before use.
#
# Every variable here is consumed. `tests/test_env_consistency.py` fails if a
# variable is declared here but read by neither the code nor docker-compose,
# because a setting that silently does nothing is worse than no setting.
#
# The credentials below are lab defaults matching the bcrypt hashes shipped in
# config/wazuh_indexer/internal_users.yml. Change them for anything reachable
# beyond localhost.

# --- LLM runtime ---
# Model the proxy asks for when a request does not name one. Ollama must already
# have it pulled: docker exec -it psl-ollama ollama pull llama3:8b
DEFAULT_MODEL=llama3:8b
OLLAMA_URL=http://ollama:11434

# --- LLM-Monitor proxy ---
# Prompts scoring at or above this value are blocked (0.0 - 1.0).
# 0.65 is the point at which weighted indicators stop being incidental overlap
# between benign and malicious phrasing on the committed corpus. Lowering it
# raises recall and false positives together; see docs/telemetry-schema.md.
CLASSIFIER_THRESHOLD=0.65

# Reporting floor. Events scoring at or above this are logged with an attack_type
# even when the verdict is allow, so sub-threshold probing is visible to hunt 2.
#
# 0.30 is derived from the corpus, not chosen arbitrarily. The weighted
# classifier produces only seven distinct scores across datasets/
# (0.0, 0.3, 0.7, 0.8, 0.85, 0.9, 1.0) — there is a gap between 0.3 and 0.7.
# A floor of 0.50 would leave the hunt-2 window empty; 0.30 captures the
# single-indicator matches that fall short of blocking. tests/test_env_consistency.py
# asserts the window is non-empty on the corpus, so a future re-weighting that
# empties it fails CI rather than silently blinding the hunt.
FLAG_THRESHOLD=0.30

# Requests above this length are rejected with 413 before classification.
# 32000 characters is well above a normal pasted document and below the point
# where the regex pass becomes a latency problem.
MAX_PROMPT_CHARS=32000

# Sliding-window rate limit. 20 requests per 60 seconds is generous for a human
# at a chat UI and low enough that token_flood.py trips it within one burst.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Completion text retained in the audit log, in characters. Truncation keeps log
# volume bounded; the insecure_output detections read the retained prefix.
MAX_LOGGED_COMPLETION_CHARS=4000

# When true, secret matches in logged prompt/completion text are masked.
# Set true before pointing this at anything with production data.
REDACT_LOGGED_SECRETS=true

# Audit log path inside the llm-monitor container. Must match the path the Wazuh
# manager reads via the shared monitor_logs volume; changing it without also
# changing config/wazuh_cluster/wazuh_manager.conf breaks ingestion.
LOG_PATH=/var/log/promptshield/monitor.json
LOG_LEVEL=INFO

# --- Host port mappings ---
LLM_MONITOR_PORT=8080
OPENSEARCH_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5602
WAZUH_INDEXER_PORT=9201
WAZUH_DASHBOARD_PORT=5601

# --- Chat front-end ---
OPENAI_API_KEY=promptshield-lab

# --- Credentials (demo values) ---
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=SecretPassword
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=MyS3cr37P450r.*-
WAZUH_DASHBOARD_USER=kibanaserver
WAZUH_DASHBOARD_PASSWORD=kibanaserver

# --- Scripts ---
INDEX_PREFIX=promptshield
