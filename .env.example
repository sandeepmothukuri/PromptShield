# PromptShield-Lab — environment configuration
# Copy to `.env` and adjust as needed.

# --- LLM ---
OLLAMA_MODEL=llama3:8b
OLLAMA_URL=http://ollama:11434

# --- LLM-Monitor proxy ---
# Prompts scoring at or above this value are blocked (0.0 – 1.0)
CLASSIFIER_THRESHOLD=0.65
# Audit log path inside the llm-monitor container (shared monitor_logs volume)
LOG_PATH=/var/log/promptshield/monitor.json

