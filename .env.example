# PromptShield-Lab — environment configuration
# Copy to `.env` and adjust as needed.

# --- LLM ---
OLLAMA_MODEL=llama3:8b
OLLAMA_URL=http://ollama:11434

# --- LLM-Monitor proxy ---
CLASSIFIER_THRESHOLD=0.65
LOG_PATH=/var/log/promptshield/monitor.json
ENABLE_LANGCHAIN_GUARD=true

# --- OpenSearch ---
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=PromptShield!2026

# --- Wazuh ---
WAZUH_API_USER=wazuh-api
WAZUH_API_PASSWORD=ChangeMe!2026

# --- General ---
LAB_TIMEZONE=UTC
LAB_LOG_LEVEL=INFO
