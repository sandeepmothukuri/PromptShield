<group name="promptshield,llm,">

  <rule id="100100" level="3">
    <decoded_as>promptshield-json</decoded_as>
    <description>PromptShield: LLM request observed</description>
  </rule>

  <rule id="100110" level="10">
    <if_sid>100100</if_sid>
    <field name="verdict">block</field>
    <description>PromptShield: prompt blocked by guardrail ($(reason))</description>
    <mitre>
      <id>T1059</id>
    </mitre>
    <group>owasp_llm01,</group>
  </rule>

  <rule id="100120" level="12">
    <if_sid>100100</if_sid>
    <field name="category">jailbreak</field>
    <description>PromptShield: LLM jailbreak attempt detected (user=$(user))</description>
    <mitre>
      <id>T1027</id>
    </mitre>
    <group>owasp_llm01,</group>
  </rule>

  <rule id="100130" level="13">
    <if_sid>100100</if_sid>
    <field name="category">data_exfiltration</field>
    <description>PromptShield: sensitive data in LLM response (user=$(user))</description>
    <mitre>
      <id>T1041</id>
    </mitre>
    <group>owasp_llm06,</group>
  </rule>

  <rule id="100140" level="10">
    <if_sid>100100</if_sid>
    <field name="category">ai_phishing</field>
    <description>PromptShield: AI-assisted phishing content generation</description>
    <mitre>
      <id>T1566.001</id>
    </mitre>
    <group>owasp_llm09,</group>
  </rule>

  <rule id="100150" level="10">
    <if_sid>100100</if_sid>
    <field name="category">system_prompt_leak</field>
    <description>PromptShield: system prompt leakage attempt</description>
    <mitre>
      <id>T1552</id>
    </mitre>
    <group>owasp_llm06,</group>
  </rule>

  <rule id="100160" level="9">
    <if_sid>100100</if_sid>
    <field name="category">token_flood</field>
    <description>PromptShield: token-flood DoS pattern</description>
    <mitre>
      <id>T1499.001</id>
    </mitre>
    <group>owasp_llm04,</group>
  </rule>

</group>
